# better-sqlite3 13 ships its prebuilt binaries inside the package, but on Windows npm still runs a
# source build (node-gyp rebuild) for it, which needs Visual Studio and fails without it. Skipping
# install scripts avoids that, and also means no dependency can run code at install time.
# Explicit commands such as `npm run build` and `npm test` still run.
ignore-scripts=true
